{
  "name": "the-rising-mangaka",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "contrast": "vite-node scripts/contrast.ts",
    "art": "vite-node scripts/pixelate.ts",
    "balance": "vite-node scripts/balance.ts",
    "check": "vite-node scripts/sync-version.ts --check && oxlint --deny-warnings && tsc -b && vitest run && vite build && vite-node scripts/contrast.ts",
    "version:check": "vite-node scripts/sync-version.ts --check",
    "version": "vite-node scripts/sync-version.ts && cargo update --workspace --manifest-path src-tauri/Cargo.toml && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "tauri": "tauri",
    "sprites": "vite-node scripts/spriteSheet.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
